{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/b14ckPanther/darb-budokai/contracts/seed/demo/integrations.schema.json",
  "title": "Demo producers",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "producers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "core",
              "cosmetic"
            ]
          },
          "keyId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "status": {
            "enum": [
              "connected",
              "idle",
              "off"
            ]
          },
          "lastEvent": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "accepted7d": {
            "type": "integer"
          },
          "rejected": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "type": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "at",
                "type",
                "reason"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "keyId",
          "scopes",
          "status",
          "lastEvent",
          "accepted7d",
          "rejected"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "producers"
  ]
}
