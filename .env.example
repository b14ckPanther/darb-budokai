# Darb Budokai local environment. Copy is made by tools/dev/gen-keys.sh, which
# replaces every __GENERATE__ with a fresh random secret and writes .env (git-ignored).
# Never commit .env. Values here are safe placeholders.

# --- PostgreSQL (one server locally, one database and role per service: ADR-022).
# Host ports avoid the defaults so other local Darb stacks can run alongside.
POSTGRES_USER=budokai
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_PORT=54320

# --- character-service
# Services run with spring-boot:run import this file; the path is relative to the service folder.
BUDOKAI_ENV_FILE=../../.env
CHARACTER_SERVICE_PORT=8081
CHARACTER_DB_URL=jdbc:postgresql://localhost:54320/character_db
CHARACTER_DB_USER=character_svc
CHARACTER_DB_PASSWORD=__GENERATE__

# --- Kafka (KRaft, single node)
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- RabbitMQ
RABBITMQ_DEFAULT_USER=budokai
RABBITMQ_DEFAULT_PASS=__GENERATE__
RABBITMQ_PORT=55672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Kafka UI (compose profile "tools")
KAFKA_UI_PORT=18090

# --- Auth (used from Phase 6). Key files are written by gen-keys.sh into secrets/.
JWT_PRIVATE_KEY_PATH=secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt-public.pem

# --- Ingest HMAC (used from Phase 5; one secret per producer is added then)
INGEST_HMAC_SECRET=__GENERATE__
